

pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building the Flask application...'
                sh 'python3 --version'
                sh 'python3 -c "import flask; print(flask.__version__)"'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'python3 -m unittest discover -s Exercise9 -p "test_app.py"'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp "${WORKSPACE}/Exercise9/app.py" "${WORKSPACE}/python-app-deploy/"
                    cp "${WORKSPACE}/Exercise9/test_app.py" "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the deployed Flask application...'
                sh '''
                    nohup python3 "${WORKSPACE}/python-app-deploy/app.py" \
                        > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &
                    echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application...'
                dir('python-app-deploy') {
                    sh 'python3 -m unittest test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
